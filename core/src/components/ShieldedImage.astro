import { Image } from "astro:assets";

// Extract all Image props except src, which we'll handle specially
const { src, alt = "", ...imageProps } = Astro.props;

// Normalise the source we expose via data attributes
const resolvedSrc = typeof src === "string" ? src : src.src;
---

<!--
  ShieldedImage component that protects images by using data-src initially.
  The BaseLayout script will swap data-src to src after gate validation.
-->
<Image
  src={src}
  data-original-src={resolvedSrc}
  data-guarded="true"
  alt={alt}
  {...imageProps}
/>

<style>
  /* Style for guarded images - darker background overlay */
  img[data-guarded="true"][data-original-src] {
    filter: brightness(0.7);
    transition: filter 0.3s ease;
  }

  /* Style for unlocked guarded images */
  img[data-guarded="true"]:not([data-original-src]) {
    filter: none;
  }

  /* Prevent right-click context menu on guarded images */
  img[data-guarded="true"] {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
    -khtml-user-drag: none;
    -moz-user-drag: none;
    -o-user-drag: none;
    pointer-events: auto;
  }

  /* Disable image drag */
  img[data-guarded="true"] {
    -webkit-user-drag: none;
    -khtml-user-drag: none;
    -moz-user-drag: none;
    -o-user-drag: none;
    user-drag: none;
  }
</style>

<script>
  // Additional client-side protection for guarded images
  const setupGuardedImages = () => {
    const guardedImages = document.querySelectorAll('img[data-guarded="true"]');

    guardedImages.forEach(img => {
      // Disable right-click context menu
      img.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        return false;
      });

      // Disable drag and drop
      img.addEventListener('dragstart', (e) => {
        e.preventDefault();
        return false;
      });

      // Add honeypot-like behavior - detect bot attempts to access src directly
      Object.defineProperty(img, '_originalSrc', {
        value: img.dataset.originalSrc,
        writable: false,
        enumerable: false,
        configurable: true
      });
    });
  };

  // Setup on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGuardedImages);
  } else {
    setupGuardedImages();
  }

  // Listen for unlock events to remove darkening filter
  const swapGuardedImages = () => {
    const guardedImages = document.querySelectorAll('img[data-guarded="true"][data-original-src]');
    guardedImages.forEach(img => {
      if (img.dataset.originalSrc) {
        img.removeAttribute('data-original-src');
      }
    });
  };

  // Listen for various unlock events
  document.addEventListener('astro-shield:unlocked', swapGuardedImages);
  window.addEventListener('astro-shield:gate-success', swapGuardedImages);
  document.addEventListener('astro:page-load', () => {
    setupGuardedImages();
    // Check if already unlocked
    if (window.__ASTRO_SHIELD_READY__) {
      swapGuardedImages();
    }
  });
</script>
