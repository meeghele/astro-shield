import { Image } from "astro:assets";

// Extract all Image props except src, which we'll handle specially
const { src, alt = "", ...imageProps } = Astro.props;

// Normalise the source we expose via data attributes
const resolvedSrc = typeof src === "string" ? src : src.src;
---

<!--
  ShieldedImage component that protects images by using data-src initially.
  The BaseLayout script will swap data-src to src after gate validation.
-->
<Image
  src={src}
  data-original-src={resolvedSrc}
  data-guarded="true"
  alt={alt}
  {...imageProps}
/>

<style>
  /* Style for guarded images - darker background overlay */
  img[data-guarded="true"][data-original-src] {
    filter: brightness(0.7);
    transition: filter 0.3s ease;
  }

  /* Style for unlocked guarded images */
  img[data-guarded="true"]:not([data-original-src]) {
    filter: none;
  }

  /* Prevent right-click context menu on guarded images */
  img[data-guarded="true"] {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
    -khtml-user-drag: none;
    -moz-user-drag: none;
    -o-user-drag: none;
    pointer-events: auto;
  }

  /* Disable image drag */
  img[data-guarded="true"] {
    -webkit-user-drag: none;
    -khtml-user-drag: none;
    -moz-user-drag: none;
    -o-user-drag: none;
    user-drag: none;
  }
</style>

<script>
  // Unlock guarded images by removing the data-original-src attribute
  const swapGuardedImages = () => {
    const guardedImages = document.querySelectorAll('img[data-guarded="true"][data-original-src]');
    guardedImages.forEach(img => {
      if (img.dataset.originalSrc) {
        img.removeAttribute('data-original-src');
      }
    });
  };

  // Setup protection handlers (right-click, drag prevention)
  const setupGuardedImages = () => {
    const guardedImages = document.querySelectorAll('img[data-guarded="true"]');
    guardedImages.forEach(img => {
      img.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        return false;
      });
      img.addEventListener('dragstart', (e) => {
        e.preventDefault();
        return false;
      });
      Object.defineProperty(img, '_originalSrc', {
        value: img.dataset.originalSrc,
        writable: false,
        enumerable: false,
        configurable: true
      });
    });
  };

  // Use MutationObserver to reliably detect unlock state (handles race condition)
  const watchForUnlock = () => {
    // Check if already unlocked
    if (document.documentElement.hasAttribute('data-astro-shield-ready')) {
      swapGuardedImages();
      return;
    }

    // Watch for attribute change
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.attributeName === 'data-astro-shield-ready') {
          if (document.documentElement.hasAttribute('data-astro-shield-ready')) {
            swapGuardedImages();
            observer.disconnect();
            break;
          }
        }
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-astro-shield-ready']
    });
  };

  // Setup protection handlers on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGuardedImages);
  } else {
    setupGuardedImages();
  }

  // Watch for unlock (handles race condition)
  watchForUnlock();

  // Keep event listeners for Astro navigation and manual unlock events
  document.addEventListener('astro-shield:unlocked', swapGuardedImages);
  document.addEventListener('astro:page-load', () => {
    setupGuardedImages();
    watchForUnlock();
  });
</script>
